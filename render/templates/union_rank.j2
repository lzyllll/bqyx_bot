<!DOCTYPE html>
<html lang="zh-CN">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <style>
    :root {
      --blue: #1689f8;
      --blue-dark: #123d79;
      --blue-text: #426ca9;
      --orange: #ff7416;
      --green: #11b976;
      --panel-bg: rgba(255, 255, 255, 0.88);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 28px;
      display: grid;
      place-items: center;
      overflow-x: hidden;
      color: var(--blue-dark);
      font-family:
        "Microsoft YaHei",
        "PingFang SC",
        "Noto Sans SC",
        Arial,
        sans-serif;
      background:
        radial-gradient(ellipse at 49% 44%, #fff 0%, #f5fbff 57%, transparent 76%),
        linear-gradient(135deg, #eaf6ff 0%, #d4ebff 43%, #f7fcff 100%);
    }

    /* 背景装饰色块 */
    body::before,
    body::after {
      content: "";
      position: fixed;
      z-index: -1;
      pointer-events: none;
    }

    body::before {
      inset: -12% -8%;
      opacity: 0.7;
      background:
        linear-gradient(142deg, transparent 11%, rgba(123, 193, 255, .28) 11.1%, transparent 25%),
        linear-gradient(145deg, transparent 23%, rgba(117, 188, 255, .22) 23.1%, transparent 38%),
        linear-gradient(25deg, transparent 6%, rgba(89, 175, 255, .18) 6.1%, transparent 20%);
    }

    body::after {
      width: 460px;
      height: 180px;
      right: -75px;
      bottom: -52px;
      transform: rotate(-14deg);
      background: linear-gradient(170deg, transparent 0 36%, #75bdff 37% 48%, #ff9a33 49% 57%, #328ef7 58%);
      opacity: 0.92;
    }

    .board {
      width: min(1092px, 100%);
      padding: 0 28px 20px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, .94);
      border-radius: 21px;
      background: var(--panel-bg);
      box-shadow:
        0 18px 48px rgba(57, 144, 221, .18),
        inset 0 0 0 1px rgba(227, 244, 255, .9);
      backdrop-filter: blur(12px);
    }

    .board-header {
      position: relative;
      min-height: 164px;
      margin: 0 -28px;
      padding: 28px 42px 16px;
      background:
        radial-gradient(ellipse at 38% 10%, rgba(255, 255, 255, .96), transparent 58%),
        linear-gradient(115deg, rgba(255, 255, 255, .78), rgba(221, 241, 255, .76));
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .trophy {
      width: 74px;
      height: 70px;
      flex: 0 0 auto;
      filter: drop-shadow(0 5px 5px rgba(255, 158, 33, .18));
    }

    h1 {
      margin: 0;
      color: #123d79;
      font-size: clamp(32px, 4vw, 48px);
      line-height: 1.15;
      font-weight: 900;
      letter-spacing: 2px;
    }

    .date-line {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 9px;
      margin-left: 0;
    }

    .date-label,
    .date-value {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      border-radius: 24px;
      font-size: 18px;
      font-weight: 700;
    }

    .date-label {
      gap: 9px;
      padding: 0 18px;
      color: #1686f7;
      background: rgba(255, 255, 255, .72);
    }

    .date-label svg {
      width: 22px;
      height: 22px;
    }

    .date-value {
      padding: 0 22px;
      color: #fff;
      background: linear-gradient(100deg, #258fff, #1479ed);
      box-shadow: 0 4px 12px rgba(21, 126, 242, .17);
      font-size: 20px;
    }

    .updated {
      position: absolute;
      right: 42px;
      bottom: 25px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #5b7fac;
      font-size: 16px;
      white-space: nowrap;
    }

    .updated svg {
      width: 22px;
      height: 22px;
      flex: 0 0 auto;
    }

    .corner-mark {
      position: absolute;
      top: 30px;
      right: 36px;
      display: flex;
      gap: 7px;
      align-items: center;
    }

    .corner-mark i {
      display: block;
      width: 22px;
      height: 26px;
      transform: skew(-36deg);
      border-radius: 2px;
      background: linear-gradient(135deg, #57b7ff, #0873e8);
    }

    .corner-mark i:nth-child(2) {
      width: 12px;
      height: 19px;
      background: #1584f5;
    }

    .corner-mark i:nth-child(3) {
      width: 22px;
      height: 26px;
      background: linear-gradient(135deg, #ffae43, #ff7416);
    }

    .table {
      padding-top: 12px;
    }

    .table-head,
    .row {
      display: grid;
      grid-template-columns: 10% 14% 27% 17% 20% 12%;
      align-items: center;
    }

    .table-head {
      min-height: 63px;
      padding: 0 24px;
      color: #fff;
      border-radius: 17px 17px 3px 3px;
      background: linear-gradient(105deg, #2786f6 0%, #278ef7 52%, #54b2f7 100%);
      box-shadow: 0 4px 10px rgba(28, 130, 238, .12);
      font-size: 20px;
      font-weight: 800;
    }

    .table-head>div,
    .row>div {
      padding-left: 12px;
    }

    .table-head>div:first-child,
    .row>div:first-child {
      padding-left: 8px;
    }

    .daily-heading {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .sort-arrow {
      color: #ff9b27;
      font-size: 24px;
      line-height: 1;
    }

    .rows {
      display: grid;
      gap: 8px;
      padding-top: 7px;
    }

    .row {
      min-height: 65px;
      padding: 0 24px;
      border: 1px solid rgba(229, 241, 252, .86);
      border-radius: 16px;
      background: rgba(255, 255, 255, .83);
      box-shadow: 0 4px 13px rgba(98, 159, 211, .08);
      color: var(--blue-text);
      font-size: 18px;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .row:hover {
      transform: translateY(-1px);
      box-shadow: 0 7px 17px rgba(60, 145, 220, .14);
    }

    .rank {
      width: 56px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: #16477f;
      background: linear-gradient(135deg, #e0f0ff, #d1e8ff);
      font-size: 21px;
      font-weight: 800;
    }

    .top-1 .rank {
      color: #fff;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      box-shadow: 0 4px 10px rgba(245, 158, 11, .3);
    }

    .top-2 .rank {
      color: #fff;
      background: linear-gradient(135deg, #94a3b8, #64748b);
      box-shadow: 0 4px 10px rgba(100, 116, 139, .25);
    }

    .top-3 .rank {
      color: #fff;
      background: linear-gradient(135deg, #fb923c, #b45309);
      box-shadow: 0 4px 10px rgba(180, 83, 9, .25);
    }

    .team-name {
      color: #123b76;
      font-weight: 800;
      font-size: 19px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
      padding-right: 8px;
    }

    .contribution {
      color: var(--green);
      font-size: 25px;
      font-weight: 900;
      white-space: nowrap;
    }

    .members {
      white-space: nowrap;
    }

    .change {
      margin-left: 10px;
      font-size: 16px;
      font-weight: 800;
    }

    .change.up {
      color: #11b976;
    }

    .change.down {
      color: #f04444;
    }

    .highlight {
      position: relative;
      z-index: 5;
      min-height: 72px;
      transform: translateY(-3px) scale(1.012);
      border: 2px solid #1689f8;
      background: linear-gradient(95deg, #cae8ff 0%, #e2f2ff 50%, #f2f9ff 100%);
      box-shadow:
        0 14px 30px rgba(16, 123, 238, 0.3),
        0 4px 12px rgba(18, 61, 121, 0.12);
    }

    .highlight::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 10px;
      border-radius: 14px 0 0 14px;
      background: linear-gradient(180deg, #0984e3, #1689f8);
    }

    .highlight .rank {
      color: #fff;
      background: linear-gradient(135deg, #1689f8, #0968c9);
      box-shadow: 0 4px 10px rgba(22, 137, 248, 0.35);
      font-weight: 900;
    }

    .highlight .team-name {
      color: #0b4592;
      font-size: 20px;
      font-weight: 900;
    }

    .highlight .team-id,
    .highlight .total,
    .highlight .members {
      color: #0b4592;
      font-weight: 800;
    }

    .highlight .contribution {
      color: #0da367;
      font-size: 26px;
      font-weight: 900;
      text-shadow: 0 1px 2px rgba(13, 163, 103, 0.15);
    }


    @media (max-width: 760px) {
      body {
        padding: 12px;
      }

      .board {
        padding: 0 12px 14px;
        border-radius: 16px;
      }

      .board-header {
        min-height: 155px;
        margin: 0 -12px;
        padding: 22px 18px 16px;
      }

      .trophy {
        width: 54px;
        height: 54px;
      }

      .brand {
        gap: 11px;
      }

      h1 {
        font-size: clamp(27px, 7vw, 38px);
      }

      .date-line {
        gap: 6px;
        margin-top: 12px;
      }

      .date-label,
      .date-value {
        min-height: 34px;
        padding: 0 11px;
        font-size: 14px;
      }

      .date-label svg {
        width: 18px;
        height: 18px;
      }

      .updated {
        right: 16px;
        bottom: 12px;
        font-size: 12px;
      }

      .updated svg {
        width: 17px;
        height: 17px;
      }

      .corner-mark {
        top: 20px;
        right: 18px;
        transform: scale(.75);
        transform-origin: top right;
      }

      .table {
        overflow-x: auto;
      }

      .table-head,
      .rows {
        min-width: 690px;
      }

      .table-head {
        min-height: 52px;
        padding: 0 14px;
        font-size: 16px;
      }

      .row {
        min-height: 57px;
        padding: 0 14px;
        font-size: 15px;
      }

      .rank {
        width: 46px;
        height: 38px;
        font-size: 18px;
      }

      .team-name {
        font-size: 16px;
      }

      .contribution {
        font-size: 21px;
      }
    }
  </style>
</head>

<body>
  <main class="board">
    <header class="board-header">
      <div class="brand">
        <svg class="trophy" viewBox="0 0 80 76" aria-hidden="true">
          <defs>
            <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ffd44e" />
              <stop offset="1" stop-color="#ff8a14" />
            </linearGradient>
          </defs>
          <path d="M17 12h46v10c0 16-9 27-23 27S17 38 17 22V12Z" fill="url(#gold)" />
          <path
            d="M18 18H8v6c0 11 7 18 18 19l-2-8c-5-2-8-6-8-11h2v-6Zm44 0h10v6c0 11-7 18-18 19l2-8c5-2 8-6 8-11h-2v-6Z"
            fill="none" stroke="#ff9b1b" stroke-width="5" stroke-linejoin="round" />
          <path d="m40 18 3.7 7.5 8.3 1.2-6 5.8 1.4 8.2-7.4-3.9-7.4 3.9 1.4-8.2-6-5.8 8.3-1.2L40 18Z" fill="#fff" />
          <path d="M34 49h12v10H34zM28 60h24v6H28zM24 68h32v5H24z" fill="url(#gold)" />
          <rect x="15" y="7" width="50" height="6" rx="3" fill="#ffc13c" />
        </svg>

        <div>
          <h1>{{ title }}</h1>
          <div class="date-line">
            <span class="date-label">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M7 3v4M17 3v4M3 9h18M7 13h2M12 13h2M7 17h2M12 17h2" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" />
              </svg>
              数据日期
            </span>
            <span class="date-value">{{ date_label }}</span>
          </div>
        </div>
      </div>

      <div class="corner-mark" aria-hidden="true">
        <i></i><i></i><i></i>
      </div>

      {% if captured_at %}
      <div class="updated">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="2" />
          <path d="M12 6.5v5.8l4 2.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        更新于 {{ captured_at }}
      </div>
      {% endif %}
    </header>

    <section class="table" aria-label="{{ title }}表">
      <div class="table-head">
        <div>排名</div>
        <div>军队ID</div>
        <div>军队名</div>
        <div>总贡献</div>
        <div class="daily-heading">{{ score_label }} <span class="sort-arrow">⬆</span></div>
        <div>成员</div>
      </div>

      <div class="rows">
        {% if rows %}
        {% for row in rows %}
        <article
          class="row{% if row.rank <= 3 %} top-{{ row.rank }}{% endif %}{% if row.highlight %} highlight{% endif %}">
          <div><span class="rank">{{ row.rank }}</span></div>
          <div class="team-id">{{ row.union_id }}</div>
          <div class="team-name" title="{{ row.name }}">{{ row.name }}</div>
          <div class="total">{{ row.contribution }}</div>
          <div class="contribution">
            {% if show_daily %}
            {% if row.today_contribution is not none %}
            {{ row.today_contribution }}
            {% else %}
            <span class="change" style="color: var(--blue-text);">—</span>
            {% endif %}
            {% else %}
            {% if row.contribution_delta %}
            <span class="change {{ 'up' if row.contribution_delta.startswith('+') else 'down' }}">{{
              row.contribution_delta }}</span>
            {% else %}
            <span class="change" style="color: var(--blue-text);">—</span>
            {% endif %}
            {% endif %}
          </div>
          <div class="members">
            {{ row.members_num }}
            {% if row.member_change %}
            <span class="change {{ 'up' if row.member_change.startswith('+') else 'down' }}">{{ row.member_change
              }}</span>
            {% endif %}
          </div>
        </article>
        {% endfor %}
        {% else %}
        <div style="text-align: center; color: var(--blue-text); padding: 50px 0; font-size: 18px;">暂无排行数据</div>
        {% endif %}
      </div>
    </section>
  </main>
</body>

</html>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    :root {
      --bg-main: #eef2f7;
      --panel-bg: #ffffff;
      --border-color: #e2e8f0;
      --primary-gold: #d97706;
      --primary-cyan: #0891b2;
      --text-main: #1e293b;
      --text-muted: #64748b;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 40px 20px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", sans-serif;
      background-color: var(--bg-main);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.10) 0%, transparent 55%),
        radial-gradient(circle at 85% 100%, rgba(245, 158, 11, 0.12) 0%, transparent 45%);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    .leaderboard {
      width: 100%;
      max-width: 760px;
      background: var(--panel-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 12px 32px rgba(15, 23, 42, 0.10);
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }
    .title-group h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: var(--text-main);
    }
    .meta {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      gap: 12px;
    }
    .meta span.highlight {
      color: var(--primary-cyan);
      font-weight: 600;
    }

    .grid-row {
      display: grid;
      grid-template-columns: 56px 90px 1.7fr 1fr 1fr 80px;
      gap: 10px;
      align-items: center;
      padding: 12px 14px;
    }

    .head {
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .list { display: flex; flex-direction: column; gap: 8px; }
    .card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: 10px;
    }

    .rank-num {
      font-size: 15px;
      font-weight: 800;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      background: #e2e8f0;
      color: #475569;
    }

    .top-1 {
      border-color: #fbbf24;
      background: linear-gradient(90deg, rgba(251, 191, 36, 0.18) 0%, #ffffff 100%);
    }
    .top-1 .rank-num {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.35);
    }

    .top-2 {
      border-color: #cbd5e1;
      background: linear-gradient(90deg, rgba(203, 213, 225, 0.25) 0%, #ffffff 100%);
    }
    .top-2 .rank-num {
      background: linear-gradient(135deg, #cbd5e1, #94a3b8);
      color: #1e293b;
    }

    .top-3 {
      border-color: #fcd34d;
      background: linear-gradient(90deg, rgba(252, 211, 77, 0.16) 0%, #ffffff 100%);
    }
    .top-3 .rank-num {
      background: linear-gradient(135deg, #fbbf24, #b45309);
      color: #fff;
    }

    /* 当前所属军队高亮 */
    .card.highlight {
      border-color: var(--primary-cyan) !important;
      background: rgba(8, 145, 178, 0.10) !important;
      box-shadow: 0 0 10px rgba(8, 145, 178, 0.18);
    }
    .card.highlight .name::after {
      content: " ◀ 本军";
      color: var(--primary-cyan);
      font-size: 12px;
      font-weight: 700;
    }

    .name { font-size: 14px; font-weight: 600; color: var(--text-main); }
    .num { font-size: 13px; color: #475569; font-family: 'Segoe UI', monospace; }
    .num.uid { font-size: 12px; color: var(--text-muted); }
    .score { font-size: 14px; font-weight: 700; color: var(--primary-gold); font-family: 'Segoe UI', monospace; }
    .change { font-size: 12px; font-weight: 700; margin-left: 4px; }
    .change.up { color: #16a34a; }
    .change.down { color: #dc2626; }

    .empty { color: var(--text-muted); padding: 50px 0; text-align: center; font-size: 14px; }
  </style>
</head>
<body>

  <div class="leaderboard">
    <div class="header">
      <div class="title-group">
        <h1>{{ title }}</h1>
        <div class="meta">
          <span>数据日期 <span class="highlight">{{ date_label }}</span></span>
        </div>
      </div>
      {% if captured_at %}
      <div class="meta" style="font-size: 12px;">更新于 {{ captured_at }}</div>
      {% endif %}
    </div>

    {% if rows %}
    <div class="grid-row head">
      <div>排行</div>
      <div>军队ID</div>
      <div>军队名</div>
      <div>总贡献</div>
      <div>日贡</div>
      <div style="text-align: right;">成员</div>
    </div>

    <div class="list">
      {% for row in rows %}
      <div class="grid-row card{% if row.rank <= 3 %} top-{{ row.rank }}{% endif %}{% if row.highlight %} highlight{% endif %}">
        <div>
          <div class="rank-num">{{ row.rank }}</div>
        </div>
        <div class="num uid">{{ row.union_id }}</div>
        <div class="name" title="{{ row.name }}">{{ row.name }}</div>
        <div class="num">{{ row.contribution }}{% if row.contribution_change %}<span class="change {{ 'up' if row.contribution_change.startswith('+') else 'down' }}">{{ row.contribution_change }}</span>{% endif %}</div>
        <div class="score">{{ row.today_contribution }}</div>
        <div class="num" style="text-align: right;">{{ row.members_num }}{% if row.member_change %}<span class="change {{ 'up' if row.member_change.startswith('+') else 'down' }}">{{ row.member_change }}</span>{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty">暂无排行数据</div>
    {% endif %}
  </div>

</body>
</html>

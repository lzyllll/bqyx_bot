<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    :root {
      --bg-main: #0b0e14;
      --panel-bg: rgba(18, 22, 31, 0.85);
      --border-color: rgba(255, 255, 255, 0.08);
      --primary-gold: #f59e0b;
      --primary-cyan: #06b6d4;
      --text-muted: #64748b;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 40px 20px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", sans-serif;
      background-color: var(--bg-main);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 100%, rgba(245, 158, 11, 0.05) 0%, transparent 40%);
      color: #f1f5f9;
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    .leaderboard {
      width: 100%;
      max-width: 760px;
      background: var(--panel-bg);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }
    .title-group h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 0.5px;
      background: linear-gradient(90deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .meta {
      font-size: 13px;
      color: var(--text-muted);
      display: flex;
      gap: 12px;
    }
    .meta span.highlight {
      color: var(--primary-cyan);
      font-weight: 600;
    }

    .grid-row {
      display: grid;
      grid-template-columns: 70px 1.8fr 1fr 1fr 90px;
      gap: 12px;
      align-items: center;
      padding: 12px 16px;
    }

    .head {
      color: var(--text-muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .list { display: flex; flex-direction: column; gap: 8px; }
    .card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 10px;
    }

    .rank-num {
      font-size: 15px;
      font-weight: 800;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.05);
      color: #94a3b8;
    }

    .top-1 {
      border-color: rgba(245, 158, 11, 0.3);
      background: linear-gradient(90deg, rgba(245, 158, 11, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    }
    .top-1 .rank-num {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #000;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
    }

    .top-2 {
      border-color: rgba(148, 163, 184, 0.3);
      background: linear-gradient(90deg, rgba(148, 163, 184, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    }
    .top-2 .rank-num {
      background: linear-gradient(135deg, #cbd5e1, #94a3b8);
      color: #000;
    }

    .top-3 {
      border-color: rgba(217, 119, 6, 0.3);
      background: linear-gradient(90deg, rgba(180, 83, 9, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    }
    .top-3 .rank-num {
      background: linear-gradient(135deg, #d97706, #b45309);
      color: #fff;
    }

    /* 当前所属军队高亮 */
    .card.highlight {
      border-color: #06b6d4 !important;
      background: rgba(6, 182, 212, 0.12) !important;
      box-shadow: 0 0 12px rgba(6, 182, 212, 0.25);
    }
    .card.highlight .name::after {
      content: " ◀ 本军";
      color: var(--primary-cyan);
      font-size: 12px;
      font-weight: 700;
    }

    .name { font-size: 14px; font-weight: 600; color: #f8fafc; }
    .num { font-size: 13px; color: #cbd5e1; font-family: 'Segoe UI', monospace; }
    .score { font-size: 14px; font-weight: 700; color: var(--primary-gold); font-family: 'Segoe UI', monospace; }

    .empty { color: var(--text-muted); padding: 50px 0; text-align: center; font-size: 14px; }
  </style>
</head>
<body>

  <div class="leaderboard">
    <div class="header">
      <div class="title-group">
        <h1>{{ title }}</h1>
        <div class="meta">
          <span>数据日期 <span class="highlight">{{ date_label }}</span></span>
        </div>
      </div>
      {% if captured_at %}
      <div class="meta" style="font-size: 12px;">更新于 {{ captured_at }}</div>
      {% endif %}
    </div>

    {% if rows %}
    <div class="grid-row head">
      <div>排名</div>
      <div>军队名</div>
      <div>总贡献</div>
      <div>日贡</div>
      <div style="text-align: right;">成员</div>
    </div>

    <div class="list">
      {% for row in rows %}
      <div class="grid-row card{% if row.rank <= 3 %} top-{{ row.rank }}{% endif %}{% if row.highlight %} highlight{% endif %}">
        <div>
          <div class="rank-num">{{ row.rank }}</div>
        </div>
        <div class="name" title="{{ row.name }}">{{ row.name }}</div>
        <div class="num">{{ row.contribution }}</div>
        <div class="score">{{ row.today_contribution }}</div>
        <div class="num" style="text-align: right;">{{ row.members_num }}</div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty">暂无排行数据</div>
    {% endif %}
  </div>

</body>
</html>

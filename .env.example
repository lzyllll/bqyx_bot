# 4399 游戏代理账号配置
BQYX_USERNAME=your_4399_username
BQYX_PASSWORD=your_4399_password
BQYX_ARCH_INDEX=4

# 快照保留策略
# 成员快照保留天数（默认 63，即保留最近 63 天，含当天）
BQYX_SNAPSHOT_RETENTION_DAYS=63
# 军队排行快照保留天数（默认 15，用于本周/上周周贡排行）
BQYX_UNION_SNAPSHOT_RETENTION_DAYS=15

# 游戏静态资源与素材路径
BQYX_RESOURCE_DIR=D:\bqyx\rs\resource
BQYX_ASSETS_DIR=D:\bqyx\rs\assets
BQYX_ARCHIVE_STORE=D:\bqyx\python\bqyx_api\data\archives

# TypeScript 核心计算包路径（用于角色面板与属性加成高速计算）
BQYX_ARCHIVE_PACKAGE=D:\bqyx\typeScript-bq\bqyx-archive
